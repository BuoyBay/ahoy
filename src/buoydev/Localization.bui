Import Common

Private Sub Fields(value As JSONItem, allowed As Array Of String)
    DevNeed(value.IsObject(), "expected object")
    For Each key As String In value.Keys()
        DevNeed(DevHas(allowed, key), "unknown field: " + key)
    Next
End Sub

Private Function LText(value As JSONItem) As String
    Dim content As String = DevString(value)
    DevNeed(Not DevMatch(content, "[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]"), "unsupported control character")
    Return content
End Function

Public Function LCatalog(filename As String) As JSONItem
    Dim value As JSONItem = DevLoad(filename, True)
    Fields(value, ["schema", "source_language", "languages", "messages"])
    DevNeed(value.Value("schema").IsNumber() And DevNumber(value.Value("schema"), 0.0) = 1.0, "catalog requires schema: 1")
    Dim source As String = DevString(value.Value("source_language"))
    DevNeed(DevMatch(source, "\\A[a-z]{2,3}(-[A-Z]{2})?\\z"), "invalid source_language")
    Dim seen As Array Of String = Array.AsResizable([source])
    For Each tag As String In DevStrings(value.Value("languages"))
        DevNeed(DevMatch(tag, "\\A[a-z]{2,3}(-[A-Z]{2})?\\z") And Not DevHas(seen, tag), "invalid or duplicate language: " + tag)
        Array.Append(seen, tag)
    Next
    Dim messages As JSONItem = value.Value("messages")
    DevNeed(messages.IsArray() And messages.Count() > 0, "catalog must contain messages")
    Dim identities As New Map Of String, Boolean()
    For i As Integer = 0 To messages.Count() - 1
        Dim message As JSONItem = messages.ValueAt(i)
        Fields(message, ["id", "default", "notes", "translations", "locations"])
        Dim identity As String = DevString(message.Value("id"))
        DevNeed(DevMatch(identity, "\\A[A-Za-z][A-Za-z0-9_]*\\z") And Not identities.ContainsKey(String.LCase(identity)), "invalid or case-colliding message ID: " + identity)
        identities.Set(String.LCase(identity), True)
        LText(message.Value("default"))
        If message.HasKey("notes") Then LText(message.Value("notes"))
        If message.HasKey("locations") Then
            For Each location As String In DevStrings(message.Value("locations"))
                DevNeed(location <> "" And Not DevMatch(location, "[\\x00-\\x1f\\x7f]"), "invalid source location")
            Next
        End If
        Dim translations As JSONItem = message.Value("translations")
        If message.HasKey("translations") Then
            Fields(translations, DevStrings(value.Value("languages")))
            For Each tag As String In translations.Keys()
                Dim translated As JSONItem = translations.Value(tag)
                Fields(translated, ["text", "source", "state"])
                LText(translated.Value("text"))
                LText(translated.Value("source"))
                DevNeed(DevHas(["translated", "needs-review"], DevString(translated.Value("state"))), "invalid translation state")
            Next
        End If
    Next
    Return value
End Function

Public Function LProblems(value As JSONItem) As JSONItem
    Dim found As JSONItem = JSONItem.NewArray()
    Dim messages As JSONItem = value.Value("messages")
    For i As Integer = 0 To messages.Count() - 1
        Dim message As JSONItem = messages.ValueAt(i)
        For Each tag As String In DevStrings(value.Value("languages"))
            Dim translated As JSONItem = message.Value("translations").Value(tag)
            Dim reason As String = ""
            If translated.IsNull() Then
                reason = "missing"
            ElseIf Not DevExact(DevString(translated.Value("source")), DevString(message.Value("default"))) Then
                reason = "stale"
            ElseIf DevString(translated.Value("state")) <> "translated" Then
                reason = "needs-review"
            End If
            If reason <> "" Then
                Dim problem As JSONItem = JSONItem.NewObject()
                problem.Value("id") = message.Value("id")
                problem.Value("language") = tag
                problem.Value("status") = reason
                found.Add(problem)
            End If
        Next
    Next
    Return found
End Function

Public Function LQuote(value As String) As String
    Return Json.Stringify(JSONItem.From(value))
End Function

Public Function LGenerated(value As JSONItem) As String
    Dim content As String = "' Generated by ahoy l10n. Edit the catalog, then regenerate.\n\n"
    Dim messages As JSONItem = value.Value("messages")
    For i As Integer = 0 To messages.Count() - 1
        Dim message As JSONItem = messages.ValueAt(i)
        Dim notes As String = message.Value("notes").AsString().Or("")
        Dim noteLines As Array Of String = DevLines(notes)
        If notes <> "" Then
            For index As Integer = 0 To Array.Count(noteLines) - 1
                If index = Array.Count(noteLines) - 1 And noteLines(index) = "" Then Exit For
                content += "' " + noteLines(index) + "\n"
            Next
        End If
        Dim defaultText As String = DevString(message.Value("default"))
        content += "Public Localization " + DevString(message.Value("id")) + " As String = " + LQuote(defaultText) + "\n"
        content += "    " + LQuote(DevString(value.Value("source_language"))) + ": " + LQuote(defaultText) + "\n"
        For Each tag As String In DevStrings(value.Value("languages"))
            Dim translated As JSONItem = message.Value("translations").Value(tag)
            If Not translated.IsNull() Then
                If DevString(translated.Value("state")) = "translated" And DevExact(DevString(translated.Value("source")), defaultText) Then
                    content += "    " + LQuote(tag) + ": " + LQuote(DevString(translated.Value("text"))) + "\n"
                End If
            End If
        Next
        content += "End Localization\n"
        If i < messages.Count() - 1 Then content += "\n"
    Next
    Return content
End Function

Public Function DevDiagnostics(outcome As JSONItem) As JSONItem
    Dim value As JSONItem = DevParse(DevString(outcome.Value("stdout")))
    DevNeed(value.IsObject() And value.Value("errors").IsArray() And value.Value("warnings").IsArray(), "invalid compiler diagnostics")
    Return value
End Function

Public Sub LVerify(value As JSONItem, content As String, compiler As String, targets As Array Of String)
    Dim validationName As String = "BuoyCatalogLanguageValidation"
    Dim identities As Array Of String = []
    Dim messages As JSONItem = value.Value("messages")
    For i As Integer = 0 To messages.Count() - 1
        Array.Append(identities, String.LCase(DevString(messages.ValueAt(i).Value("id"))))
    Next
    While DevHas(identities, String.LCase(validationName))
        validationName += "X"
    End While
    Dim probe As String = "\nPrivate Localization " + validationName + " As String = \"\"\n"
    Dim languages As Array Of String = Array.AsResizable([DevString(value.Value("source_language"))])
    For Each tag As String In DevStrings(value.Value("languages"))
        Array.Append(languages, tag)
    Next
    For Each tag As String In languages
        probe += "    " + LQuote(tag) + ": \"\"\n"
    Next
    probe += "End Localization\n"
    Dim work As String = DevTemp("buoy-l10n-")
    Try
        Dim source As String = Path.Join(work, "Messages.bui")
        DevWrite(source, content + probe)
        Dim checks As Array Of String = targets
        If Array.Count(checks) = 0 Then checks = [""]
        For Each target As String In checks
            Dim argv As Array Of String = Array.AsResizable([compiler, source, "--check", "--diagnostic-format", "json"])
            If target <> "" Then
                Array.Append(argv, "--target")
                Array.Append(argv, target)
            End If
            Dim outcome As JSONItem = DevExecute(argv, work)
            DevNeed(Not outcome.Value("timeout").AsBoolean().Or(False), "localization compiler check timed out")
            Dim diagnostic As JSONItem = DevDiagnostics(outcome)
            DevNeed(DevNumber(outcome.Value("returncode"), 1.0) = 0.0 And diagnostic.Value("errors").Count() = 0, "localization compiler check failed: " + Json.Stringify(diagnostic))
            If diagnostic.Value("warnings").Count() > 0 Then StdErr.WriteLine(Json.Stringify(diagnostic.Value("warnings")))
        Next
    Finally
        DevRemoveTree(work)
    End Try
End Sub

Public Function LExport(value As JSONItem, language As String) As String
    DevNeed(DevHas(DevStrings(value.Value("languages")), language), "language must be declared in the catalog")
    Dim header As String = "Language: " + language + "\nContent-Type: text/plain; charset=UTF-8\nMIME-Version: 1.0\n"
    Dim content As String = "msgid \"\"\nmsgstr " + LQuote(header) + "\n\n"
    Dim messages As JSONItem = value.Value("messages")
    For i As Integer = 0 To messages.Count() - 1
        Dim message As JSONItem = messages.ValueAt(i)
        If message.HasKey("locations") Then
            For Each location As String In DevStrings(message.Value("locations"))
                content += "#: " + location + "\n"
            Next
        End If
        Dim notes As String = message.Value("notes").AsString().Or("")
        If notes <> "" Then
            Dim lines As Array Of String = DevLines(notes)
            For index As Integer = 0 To Array.Count(lines) - 1
                If index = Array.Count(lines) - 1 And lines(index) = "" Then Exit For
                content += "#. " + lines(index) + "\n"
            Next
        End If
        Dim translated As JSONItem = message.Value("translations").Value(language)
        Dim targetText As String = ""
        Dim poFlags As Array Of String = []
        If Not translated.IsNull() Then
            targetText = DevString(translated.Value("text"))
            If DevString(translated.Value("state")) <> "translated" Or Not DevExact(DevString(translated.Value("source")), DevString(message.Value("default"))) Then Array.Append(poFlags, "fuzzy")
            If targetText = "" Then Array.Append(poFlags, "buoy-empty")
        End If
        If Array.Count(poFlags) > 0 Then content += "#, " + String.Join(poFlags, ", ") + "\n"
        content += "msgctxt " + LQuote(DevString(message.Value("id"))) + "\nmsgid " + LQuote(DevString(message.Value("default"))) + "\nmsgstr " + LQuote(targetText) + "\n"
        If i < messages.Count() - 1 Then content += "\n"
    Next
    Return content
End Function

Public Function LParsePO(source As String) As JSONItem
    Dim entries As JSONItem = JSONItem.NewArray()
    Dim entry As JSONItem = JSONItem.NewObject()
    Dim poFlags As Array Of String = []
    Dim active As String = ""
    For Each raw As String In DevLines(source + "\n")
        Dim line As String = String.Trim(raw)
        If line = "" Then
            If entry.HasKey("msgid") Then
                DevNeed(entry.HasKey("msgstr"), "PO entry missing msgstr")
                entry.Value("flags") = DevArray(poFlags)
                entries.Add(entry)
            Else
                DevNeed(entry.Count() = 0, "incomplete PO entry")
            End If
            entry = JSONItem.NewObject()
            poFlags = []
            active = ""
            Continue For
        End If
        DevNeed(Not String.StartsWith(line, "#~", True), "remove obsolete PO entries before import")
        If String.StartsWith(line, "#,", True) Then
            For Each flagName As String In String.Split(String.Substring(line, 2), ",")
                Array.Append(poFlags, String.Trim(flagName))
            Next
            Continue For
        End If
        If String.StartsWith(line, "#", True) Then Continue For
        Dim literal As String = ""
        If String.StartsWith(line, "\"", True) Then
            DevNeed(active <> "", "PO continuation without a field")
            literal = line
        Else
            Dim splitAt As Integer = String.IndexOf(line, " ", 0, True)
            Dim tabAt As Integer = String.IndexOf(line, "\t", 0, True)
            If tabAt >= 0 And (splitAt < 0 Or tabAt < splitAt) Then splitAt = tabAt
            DevNeed(splitAt > 0, "unsupported PO syntax")
            active = String.Left(line, splitAt)
            DevNeed(DevHas(["msgctxt", "msgid", "msgstr"], active), "unsupported PO syntax (plurals are not supported)")
            DevNeed(Not entry.HasKey(active), "duplicate PO field")
            literal = String.Trim(String.Substring(line, splitAt + 1))
        End If
        Dim decoded As String = LText(DevParse(literal))
        entry.Value(active) = entry.Value(active).AsString().Or("") + decoded
    Next
    Return entries
End Function

Public Function LImport(value As JSONItem, language As String, source As String) As JSONItem
    DevNeed(DevHas(DevStrings(value.Value("languages")), language), "language must be declared in the catalog")
    If String.StartsWith(source, String.Chr(65279), True) Then source = String.Substring(source, 1)
    Dim entries As JSONItem = LParsePO(source)
    Dim header As JSONItem = Nil
    For i As Integer = 0 To entries.Count() - 1
        Dim entry As JSONItem = entries.ValueAt(i)
        If DevString(entry.Value("msgid")) = "" And Not entry.HasKey("msgctxt") Then
            DevNeed(header = Nil, "PO requires exactly one header")
            header = entry
        End If
    Next
    DevNeed(header <> Nil, "PO header is required")
    Dim metadata As JSONItem = JSONItem.NewObject()
    For Each line As String In DevLines(DevString(header.Value("msgstr")))
        Dim colon As Integer = String.IndexOf(line, ":", 0, True)
        If colon >= 0 Then
            Dim key As String = String.LCase(String.Left(line, colon))
            DevNeed(Not metadata.HasKey(key), "duplicate PO header field")
            metadata.Value(key) = String.Trim(String.Substring(line, colon + 1))
        End If
    Next
    DevNeed(DevExact(metadata.Value("language").AsString().Or(""), language) And String.Contains(String.LCase(metadata.Value("content-type").AsString().Or("")), "charset=utf-8", True), "PO language/UTF-8 header does not match import")
    Dim seen As Array Of String = []
    Dim messages As JSONItem = value.Value("messages")
    ' Work on a deep copy: rejection must never mutate the caller's catalog.
    Dim updated As JSONItem = DevParse(Json.Stringify(value))
    For i As Integer = 0 To entries.Count() - 1
        Dim entry As JSONItem = entries.ValueAt(i)
        If Not entry.HasKey("msgctxt") And DevString(entry.Value("msgid")) = "" Then Continue For
        Dim identity As String = DevString(entry.Value("msgctxt"))
        DevNeed(Not DevHas(seen, identity), "duplicate PO context: " + identity)
        Array.Append(seen, identity)
        Dim message As JSONItem = Nil
        For index As Integer = 0 To messages.Count() - 1
            If DevExact(DevString(messages.ValueAt(index).Value("id")), identity) Then message = updated.Value("messages").ValueAt(index)
        Next
        DevNeed(message <> Nil, "unknown PO context: " + identity)
        DevNeed(DevExact(DevString(entry.Value("msgid")), DevString(message.Value("default"))), "source changed; export a fresh catalog before importing")
        Dim poFlags As Array Of String = DevStrings(entry.Value("flags"))
        Dim targetText As String = DevString(entry.Value("msgstr"))
        If targetText = "" And Not DevHas(poFlags, "buoy-empty") Then Continue For
        Dim translated As JSONItem = JSONItem.NewObject()
        translated.Value("text") = targetText
        translated.Value("source") = message.Value("default")
        translated.Value("state") = "translated"
        If DevHas(poFlags, "fuzzy") Then translated.Value("state") = "needs-review"
        Dim translations As JSONItem = message.Value("translations")
        If translations.IsNull() Then
            translations = JSONItem.NewObject()
            message.Value("translations") = translations
        End If
        translations.Value(language) = translated
    Next
    DevNeed(Array.Count(seen) = messages.Count(), "PO must contain every current message")
    Return updated
End Function

Public Function LPseudo(value As String) As String
    Dim content As String = "⟦"
    Dim vowels As Array Of String = ["a", "e", "i", "o", "u", "A", "E", "I", "O", "U"]
    Dim accents As Array Of String = ["á", "é", "í", "ó", "ú", "Á", "É", "Í", "Ó", "Ú"]
    For index As Integer = 0 To String.Len(value) - 1
        Dim ch As String = String.Substring(value, index, 1)
        For offset As Integer = 0 To 9
            If DevExact(ch, vowels(offset)) Then
                ch = accents(offset)
                Exit For
            End If
        Next
        content += ch
    Next
    For index As Integer = 1 To Math.Max(1, String.Len(value) \ 6)
        content += " ~"
    Next
    Return content + "⟧"
End Function
